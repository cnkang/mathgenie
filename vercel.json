{
  "routes": [
    {
      "src": "^/sw\\.js$",
      "headers": {
        "cache-control": "no-cache, max-age=0"
      },
      "continue": true
    },
    {
      "src": "^/assets/.*-[A-Za-z0-9_-]{8,}\\.(js|css|svg|woff2)(\\.(br|gz))?$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ]
}
